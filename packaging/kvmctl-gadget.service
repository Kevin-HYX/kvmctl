[Unit]
Description=Prepare kvmctl USB Gadget HID functions
After=sys-kernel-config.mount systemd-modules-load.service
Before=kvmctl.service

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=75s
ExecStart=/usr/local/lib/kvmctl/setup-gadget.sh up
ExecStop=/usr/local/lib/kvmctl/setup-gadget.sh down

[Install]
WantedBy=multi-user.target
